{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    {
      "pattern": "go.alphabravomedia.co",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "vars": {
    "NUXT_CF_ACCOUNT_ID": "de011be818652cd288a0b1d934502de3",
    "NUXT_HOME_URL": ""
  },
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Values marked with DEPLOY_* below are placeholders for local/dev.
  // CLI deploy (pnpm deploy:worker / deploy:config) rewrites them into gitignored wrangler.deploy.jsonc.
  // Prefer setting DEPLOY_* in .env or Workers Builds / Pages variables — do not hardcode production IDs here.
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink" // Override with DEPLOY_ANALYTICS_DATASET (default: sink). Keep in sync with NUXT_DATASET at runtime.
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "07e59339b8e245deade3e82af05c7b18",
      "id": "07e59339b8e245deade3e82af05c7b18"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sink", // Override with DEPLOY_D1_DATABASE_NAME (default: sink)
      "database_id": "0f04069d-2d88-40e1-a6ca-53f35b6946b8", // Override with DEPLOY_D1_DATABASE_ID (required for CLI deploy)
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      // preview_bucket_name: DEPLOY_R2_PREVIEW_BUCKET_NAME (falls back to DEPLOY_R2_BUCKET_NAME)
      // omit DEPLOY_R2_BUCKET_NAME to drop R2 from generated deploy config
      "preview_bucket_name": "sink",
      "bucket_name": "sink"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"] // Run backup task daily at 00:00 UTC
  }
}
